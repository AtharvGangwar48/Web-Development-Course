<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Post</title>
</head>
<body>
    <h3>Write a new chat to display..</h3>
    <form action="/chats" method="POST">
        <br>
        <input type="text" placeholder="Enter name to be displayed" name="from">
        <br>
        <br>
        <textarea name="msg" rows="10" cols="35">Write your message here...</textarea>
        <br>
        <br>
        <input type="text" placeholder="Recievers name" name="to">
        <br>
        <br>
        <button>Create Chat</button>
    </form>
</body>
</html>