<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quora</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Quora Posts</h1>
    <button><a href="http://localhost:8080/posts/new">New Post</a></button>
    <% for (post of posts) { %>
        <div class="post">
            <h3 class="user"><%= post.username %></h3>
            <h4 class="content"> <%= post.content %></h4>
            <a href="http://localhost:8080/posts/<%=post.id%>">Show in detail</a>
            <a href="http://localhost:8080/posts/<%=post.id%>/edit">Edit</a>
            <form method="post" action="http://localhost:8080/posts/<%=post.id%>?_method=DELETE">
                <button>Delete</button>
            </form>
        </div>        
       <% } %> 
</body>
</html>